const MinTemperature = 273.15 + 10;
const MaxTemperature = 273.15 + 30;

void Main()
{
    while(true)
    {
        yield;
        
        Base.Mode = Base.PressureOutput < 9000 
                  & Base.PressureInput > 55 
                  & Base.TemperatureInput <= MaxTemperature
                  & Base.TemperatureInput >= MinTemperature;
    }
}
