pin CoolerValve d0;

const TargetTemperature = 273.15 + 25;

void Main()
{
    while(true)
    {
        yield;
        
        Base.Mode = Base.PressureOutput < 40000 
                  & Base.RatioCarbonDioxideInput > 0
                  & Base.TemperatureOutput <= TargetTemperature + 3;
    
        CoolerValve.On = Base.TemperatureOutput > TargetTemperature;
    }
}
