{
  "name": "ic11",
  "displayName": "ic11",
  "description": "ic11 programming language syntax",
  "version": "1.0.0-snapshot",
  "repository": {
    "type": "git",
    "url": "https://github.com/Raibo/ic11.git"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./src/extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "ic11",
        "aliases": [
          "Ic11",
          "ic11"
        ],
        "extensions": [
          ".ic11"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "ic10",
        "aliases": [
          "Ic10",
          "ic10"
        ],
        "extensions": [
          ".ic10"
        ]
      }
    ],
    "grammars": [
      {
        "language": "ic11",
        "scopeName": "source.ic11",
        "path": "./syntaxes/ic11.tmLanguage.json"
      },
      {
        "language": "ic10",
        "scopeName": "source.ic10",
        "path": "./syntaxes/ic10.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "ic11.compile",
        "title": "Compile IC11"
      }
    ],
    "configurationDefaults": {
      "[ic11]": {
        "editor.tokenColorCustomizations": {
          "textMateRules": [
            {
              "scope": "entity.name.function.ic11",
              "settings": {
                "foreground": "#DCDCAA"
              }
            },
            {
              "scope": "variable.other.property.ic11",
              "settings": {
                "foreground": "#9CDCFE"
              }
            },
            {
              "scope": "support.function.builtin.ic11",
              "settings": {
                "foreground": "#4EC9B0"
              }
            },
            {
              "scope": "support.constant.device.ic11",
              "settings": {
                "foreground": "#4FC1FF"
              }
            },
            {
              "scope": "storage.type.ic11",
              "settings": {
                "foreground": "#569CD6"
              }
            },
            {
              "scope": "punctuation.accessor.ic11",
              "settings": {
                "foreground": "#C586C0"
              }
            },
            {
              "scope": "punctuation.separator.statement.ic11,punctuation.definition.block.ic11,punctuation.section.parens.ic11,punctuation.section.brackets.ic11,punctuation.separator.comma.ic11,punctuation.separator.key-value.ic11",
              "settings": {
                "foreground": "#808080"
              }
            }
          ]
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint src test",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.93.0",
    "@types/mocha": "^10.0.7",
    "@types/node": "20.x",
    "eslint": "^9.9.1",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1"
  }
}