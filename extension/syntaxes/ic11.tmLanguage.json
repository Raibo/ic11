{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "ic11",
	"scopeName": "source.ic11",
	"patterns": [
		{
			"include": "#comments"
		},
		{
			"include": "#keywords"
		},
		{
			"include": "#constants"
		},
		{
			"include": "#operators"
		},
		{
			"include": "#punctuation"
		},
		{
			"include": "#identifiers"
		}
	],
	"repository": {
		"keywords": {
			"patterns": [
				{
					"name": "storage.type.ic11",
					"match": "\\b(void|real|var|const|pin)\\b"
				},
				{
					"name": "keyword.control.ic11",
					"match": "\\b(while|for|if|else|yield|return|continue|break|hcf|sleep)\\b"
				},
				{
					"name": "support.function.builtin.ic11",
					"match": "\\b(Base|DeviceWithId|DevicesOfType|WithName|rand|not|round|ceil|floor|trunc|abs|sqrt|exp|log|sin|asin|cos|acos|tan|atan|seqz|snez|sgez|sgtz|slez|sltz|snan|snanz|add|sub|mul|div|mod|max|min|atan2|and|or|xor|sll|srl|sla|sra|nor|seq|sne|sgt|sge|slt|sle|sapz|snaz|select|sap|sna)\\b"
				},
				{
					"name": "support.constant.device.ic11",
					"match": "\\b(Pins|Slots|Reagent|Stack|Clear)\\b"
				},
				{
					"name": "constant.language.pin.ic11",
					"match": "\\b(db|d0|d1|d2|d3|d4|d5)\\b"
				}
			]
		},
		"constants": {
			"patterns": [
				{
					"name": "string.quoted.double.ic11",
					"match": "\"[^\"\\r\\n]*\""
				},
				{
					"name": "string.quoted.single.ic11",
					"match": "'(?:[^'\\\\]|\\\\.)*'"
				},
				{
					"name": "constant.numeric.hex.ic11",
					"match": "\\b0x[0-9a-fA-F_]+\\b"
				},
				{
					"name": "constant.numeric.binary.ic11",
					"match": "\\b0b[01_]+\\b"
				},
				{
					"name": "constant.numeric.ic11",
					"match": "\\b\\d+\\.\\d+\\b|\\b\\d*\\.\\d+\\b"
				},
				{
					"name": "constant.numeric.ic11",
					"match": "\\b\\d+\\b"
				},
				{
					"name": "constant.language.boolean.ic11",
					"match": "\\b(true|false)\\b"
				}
			]
		},
		"operators": {
			"patterns": [
				{
					"name": "keyword.operator.ic11",
					"match": "(<<a|>>a|<<l|>>l|<<|>>|<=|>=|==|!=|~=|~==|~!=|&&|\\|\\||\\+|\\-|\\*|/|%|~|!|\\^|\\||\\&|=|<|>|\\?)"
				}
			]
		},
		"punctuation": {
			"patterns": [
				{
					"name": "punctuation.separator.statement.ic11",
					"match": ";"
				},
				{
					"name": "punctuation.definition.block.ic11",
					"match": "[{}]"
				},
				{
					"name": "punctuation.section.parens.ic11",
					"match": "[()]"
				},
				{
					"name": "punctuation.section.brackets.ic11",
					"match": "[\\[\\]]"
				},
				{
					"name": "punctuation.separator.comma.ic11",
					"match": ","
				},
				{
					"name": "punctuation.separator.key-value.ic11",
					"match": ":"
				}
			]
		},
		"identifiers": {
			"patterns": [
				{
					"name": "entity.name.function.ic11",
					"match": "\\b[A-Za-z_][A-Za-z0-9_]*\\s*(?=\\()"
				},
				{
					"match": "(\\.)(\\s*)([A-Za-z_][A-Za-z0-9_]*)",
					"captures": {
						"1": {
							"name": "punctuation.accessor.ic11"
						},
						"3": {
							"name": "variable.other.property.ic11"
						}
					}
				},
				{
					"name": "variable.other.readwrite.ic11",
					"match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
				}
			]
		},
		"comments": {
			"patterns": [
				{
					"name": "comment.line.double-slash.ic11",
					"match": "//.*$"
				},
				{
					"name": "comment.block.ic11",
					"begin": "/\\*",
					"end": "\\*/"
				}
			]
		}
	}
}
